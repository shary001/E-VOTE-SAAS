# Copy this file to .env and fill in real values. Never commit .env itself.

# --- Database (Supabase) ---------------------------------------------------
# Supabase dashboard -> Project Settings -> Database -> Connection string
# (use the "Transaction pooler" URI, port 6543, for serverless-friendly hosts;
# the direct 5432 URI also works fine for Render).
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_PROJECT_REF.supabase.co:5432/postgres

# --- Auth --------------------------------------------------------------
# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-string
JWT_EXPIRES_IN=2h

# --- Outgoing email (verification links, application decisions) -----------
# Fastest path with zero domain setup: a Gmail account + an "app password"
# (Google Account -> Security -> 2-Step Verification -> App passwords).
# Swap these for Resend/Postmark once you own a domain and want to send at
# real volume — only server/utils/email.js needs to change.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-character-app-password
SMTP_FROM=you@gmail.com

# Used to build the link inside verification emails. Your Render URL in
# production, http://localhost:3000 while developing locally.
APP_URL=http://localhost:3000

PORT=3000
NODE_ENV=development
